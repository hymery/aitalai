# Домен без https://. A-запись домена должна указывать на VPS.
DOMAIN=aitalai.example.ru

POSTGRES_DB=bashkir_school
POSTGRES_USER=bashkir
POSTGRES_PASSWORD=replace_with_long_random_hex
SECRET_KEY=replace_with_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
MAX_BOT_TOKEN=replace_with_real_max_token
MAX_WEBAPP_URL=https://aitalai.example.ru/miniapp/max
PLATFORM_AUTH_TTL_SECONDS=86400
PLATFORM_AUTH_DEV_BYPASS=0

AI_ENABLED=1
DEEPSEEK_API_KEY=replace_with_deepseek_or_minirouter_key
DEEPSEEK_BASE_URL=https://api.minirouter.sh/v1
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash-1017-ultrafast
AI_DAILY_MESSAGE_LIMIT=60
AI_MAX_HISTORY=12

TTS_ENABLED=1
USE_MOCK=0
REMINDER_ENABLED=1
REMINDER_TIME=09:00
