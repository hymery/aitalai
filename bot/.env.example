# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Базовый URL backend API (без завершающего слэша)
API_URL=http://localhost:8000

# 1 — встроенная заглушка API (без backend)
# 0 — реальные HTTP-запросы
USE_MOCK=1

# Таймаут запросов к API в секундах (необязательно)
API_TIMEOUT=15

# Прокси для Telegram API (нужен, если api.telegram.org недоступен напрямую)
# TELEGRAM_PROXY=socks5://127.0.0.1:10808

# Адрес Mini App. Локальный сервер поднимается вместе с ботом.
WEBAPP_URL=http://localhost:8080

# Интерфейс и порт локального сервера Mini App
# 0.0.0.0 — доступ с телефона по IP компьютера в той же сети
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Ежедневные напоминания: 1 — включены, 0 — выключены
REMINDER_ENABLED=1
# Время напоминания по локальному времени сервера, формат ЧЧ:ММ
REMINDER_TIME=09:00

# Файл локального реестра пользователей (для напоминаний)
USERS_FILE=users.json
