# Токен бота от @BotFather (BOT_TOKEN тоже поддерживается)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Необязательно: токен MAX-бота. Запуск: python max_bot.py
# MAX_BOT_TOKEN=replace_with_real_max_token
# MAX_USERS_FILE=max_users.json

# Базовый URL backend API для Python-бота, без завершающего слэша
API_URL=http://localhost:8000
API_TIMEOUT=15

# Для единого MVP используйте реальный backend, а не заглушку
USE_MOCK=0

# Прокси для Telegram API, если api.telegram.org недоступен напрямую
# TELEGRAM_PROXY=socks5://127.0.0.1:10808

# Общий фронтенд с карточками, курсом и кабинетами ролей
# ../frontend — при локальном запуске; /app/frontend — в Docker
WEBAPP_DIR=../frontend
WEBAPP_URL=http://localhost:8080
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Для Telegram на телефоне замените WEBAPP_URL на HTTPS-туннель
# WEBAPP_URL=https://your-tunnel.example

# Ежедневные напоминания
REMINDER_ENABLED=1
REMINDER_TIME=09:00
USERS_FILE=users.json
