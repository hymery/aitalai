# Локально можно не задавать: backend сначала проверит PostgreSQL, затем использует SQLite
# DATABASE_URL=postgresql+psycopg2://bashkir:bashkir@localhost:5432/bashkir_school
# DATABASE_URL=sqlite:///./bashkir.db

# Обязательно замените в любом публичном окружении
SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Токены ботов: backend проверяет ими подпись initData мини-приложений.
# Без TELEGRAM_BOT_TOKEN вход через Telegram Mini App вернёт 503, без MAX_BOT_TOKEN — вход через MAX.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# MAX_BOT_TOKEN=replace_with_real_max_token

# Сколько секунд initData считается свежей (по auth_date). 0 — не проверять срок.
# PLATFORM_AUTH_TTL_SECONDS=86400

# Только для локальной разработки: вход по голому telegram_id/max_id без initData.
# Никогда не включайте на публичном сервере!
# PLATFORM_AUTH_DEV_BYPASS=0

# Необязательно: токен для импорта закрытого датасета Hugging Face
# HF_TOKEN=hf_replace_me

# Башкирская озвучка Silero. Модель не входит в репозиторий (~88 МБ).
TTS_ENABLED=1
# TTS_MODEL_PATH=./.cache/models/v5_cis_base_nostress.pt
# TTS_CACHE_DIR=./tts_cache

# Для docker-compose
POSTGRES_DB=bashkir_school
POSTGRES_USER=bashkir
POSTGRES_PASSWORD=bashkir
