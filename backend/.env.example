# DATABASE_URL=sqlite:///./bashkir.db

# Обязательно замените в любом публичном окружении
SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Необязательно: токен для импорта закрытого датасета Hugging Face
